# Secrets of ONE environment, read by shared/base/15-secrets.yml. Template only - never commit real values.
#
# Interactive run on the control node:
#   install -m 600 /dev/null ~/.secrets/<environment>.env      # root/owner-only file outside the repository
#   edit it (copy of this template), then in the shell of the run:
#   set -a; . ~/.secrets/<environment>.env; set +a
# AWX / Tower: a custom credential type per environment injects the same variable names (README, "AWX").
#
# Preflight names every missing variable. Values are used as they are (no quoting needed for AWX; in this
# file quote a value with single quotes when it contains spaces or shell characters).

# LDAP bind account used by MDS to search users and groups
IAC_SECRET_LDAP_BIND_PASSWORD=
# MDS super user (mds_super_user)
IAC_SECRET_MDS_SUPER_USER_PASSWORD=
# LDAP passwords of the component service accounts (*_ldap_user)
IAC_SECRET_KAFKA_BROKER_LDAP_PASSWORD=
IAC_SECRET_SCHEMA_REGISTRY_LDAP_PASSWORD=
IAC_SECRET_KAFKA_CONNECT_LDAP_PASSWORD=
IAC_SECRET_KAFKA_REST_LDAP_PASSWORD=
IAC_SECRET_CONTROL_CENTER_NEXT_GEN_LDAP_PASSWORD=

# Broker and KRaft authentication: SCRAM-SHA-512 password of the brokers, PLAIN password of the KRaft controllers.
# Letters and digits only (they end up in JAAS configurations), e.g. openssl rand -hex 24
IAC_SECRET_KAFKA_BROKER_SCRAM_PASSWORD=
IAC_SECRET_KAFKA_CONTROLLER_PLAIN_PASSWORD=

# OAuth client secrets - only with auth_mode oauth / ldap_with_oauth (iac_required_secrets decides)
IAC_SECRET_OAUTH_SUPERUSER_CLIENT_SECRET=
IAC_SECRET_SCHEMA_REGISTRY_OAUTH_CLIENT_SECRET=
IAC_SECRET_KAFKA_CONNECT_OAUTH_CLIENT_SECRET=
IAC_SECRET_KAFKA_REST_OAUTH_CLIENT_SECRET=
IAC_SECRET_CONTROL_CENTER_OAUTH_CLIENT_SECRET=

# prod tier: Confluent license key / dr: Cluster Linking password encoder secret
IAC_SECRET_CONFLUENT_LICENSE=
IAC_SECRET_PASSWORD_ENCODER_SECRET=
