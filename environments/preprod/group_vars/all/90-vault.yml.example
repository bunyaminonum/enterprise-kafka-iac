---
# Secrets of the "preprod" environment - TEMPLATE (files ending in .example are ignored by Ansible).
#
# 1. Copy this file to 90-vault.yml in the same directory.
# 2. Replace every value with an INDIVIDUALLY encrypted string that uses the environment identity:
#      ansible-vault encrypt_string --vault-id preprod@prompt --encrypt-vault-id preprod --name <variable>
#    Encrypt values, not the whole file: pull requests stay reviewable and validation/rendering
#    run without any vault password (encrypted values are only decrypted when used).
# 3. Required names = iac_required_secrets of base + tier + environment (listed below).
#    Preflight refuses to deploy while a value is missing or CHANGE_ME.
vault_ldap_bind_password: CHANGE_ME
vault_mds_super_user_password: CHANGE_ME
vault_kafka_broker_ldap_password: CHANGE_ME
vault_schema_registry_ldap_password: CHANGE_ME
vault_kafka_connect_ldap_password: CHANGE_ME
vault_kafka_rest_ldap_password: CHANGE_ME
vault_control_center_next_gen_ldap_password: CHANGE_ME
vault_oauth_superuser_client_secret: CHANGE_ME
vault_schema_registry_oauth_client_secret: CHANGE_ME
vault_kafka_connect_oauth_client_secret: CHANGE_ME
vault_kafka_rest_oauth_client_secret: CHANGE_ME
vault_control_center_oauth_client_secret: CHANGE_ME
vault_secrets_protection_masterkey: CHANGE_ME
vault_confluent_license: CHANGE_ME
